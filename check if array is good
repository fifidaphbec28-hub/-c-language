#include <stdbool.h>
bool isGood(int* nums, int numsSize) {
    int n = numsSize - 1;
    if (n < 1) {
        return false;
    }
    int count[202] = {0};
    for (int i = 0; i < numsSize; i++) {
        int val = nums[i];
        if (val < 1 || val > n) {
            return false;
        }
        count[val]++;
    }
    for (int i = 1; i < n; i++) {
        if (count[i] != 1) {
            return false;
        }
    }
    if (count[n] != 2) {
        return false;
    }
    
    return true;
}
