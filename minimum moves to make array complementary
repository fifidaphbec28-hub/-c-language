#include <stdio.h>
#include <stdlib.h>
#include <limits.h>
int minMoves(int* nums, int numsSize, int limit) {
    int max_sum = 2 * limit;
    int* diff = (int*)calloc(max_sum + 2, sizeof(int));
    
    for (int i = 0; i < numsSize / 2; i++) {
        int A = nums[i];
        int B = nums[numsSize - 1 - i];
        if (A > B) {
            int temp = A;
            A = B;
            B = temp;
        }
        diff[2] += 2;
        diff[max_sum + 1] -= 2;
        diff[A + 1] -= 1;
        diff[B + limit + 1] += 1;
        diff[A + B] -= 1;
        diff[A + B + 1] += 1;
    }
    
    int min_moves = INT_MAX;
    int current_moves = 0;
    for (int x = 2; x <= max_sum; x++) {
        current_moves += diff[x];
        if (current_moves < min_moves) {
            min_moves = current_moves;
        }
    }
    free(diff);
    return min_moves;
}
