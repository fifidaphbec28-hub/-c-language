int* separateDigits(int* nums, int numsSize, int* returnSize) {
     int temp[6];
    int* ans = (int*)malloc(numsSize * 6 * sizeof(int));
    int count = 0;
    for (int i = 0; i < numsSize; i++) {
        int val = nums[i];
        int tempIdx = 0;
        while (val > 0) {
            temp[tempIdx++] = val % 10;
            val /= 10;
        }
        for (int j = tempIdx - 1; j >= 0; j--) {
            ans[count++] = temp[j];
        }
    }
    ans = (int*)realloc(ans, count * sizeof(int));
    *returnSize = count;
    return ans;
}
    
