#include <stdio.h>

int main() {
    int age;
    printf("Enter your age: ");
       if (scanf("%d", &age) != 1) {
        printf("Invalid input. Please enter a valid numerical age.\n");
        return 1; 
         if (age >= 18) {
        printf("You are eligible to vote.\n");
    } else if (age >= 0) {
        printf("You are not eligible to vote. You must be at least 18 years old.\n");
    } else {
        printf("Invalid age entered. Age cannot be a negative value.\n");
    }
 return 0;
}
